# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.venv/
venv/
env/
PUMC_venv/

# ── 测试 / 覆盖率 ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── 构建产物 ──────────────────────────────────────────────────────────────────
# 只忽略仓库根目录的 PyInstaller 产物。写成 `dist/` 会匹配任意层级的 dist 目录，
# 把下面明确要求提交的 web/dist/ 一起吃掉（`git check-ignore -v web/dist/index.html`
# 会指到这一行），结果就是新克隆的仓库没有前端产物，启动后只有 API、页面打不开。
/dist/
build/
installer_output/
*.exe
*.msi
*.spec

# ── 前端 ──────────────────────────────────────────────────────────────────────
web/node_modules/
# web/dist/ 由 app_web.py 静态托管，必须提交
# 如果不需要提交构建产物，取消下行注释：
# web/dist/

# ── 数据文件 ──────────────────────────────────────────────────────────────────
test_data/
exports/

# ── 日志 & 临时文件 ───────────────────────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.backup

# ── IDE / 编辑器 ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── 操作系统 ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db

# ── AI 工具 ───────────────────────────────────────────────────────────────────
.cursorindexingignore
.augmentignore
.specstory/
.claude/
.pi/